# Copy to .env.local and fill in what you have. Everything is optional —
# sources without configuration fall back to realistic mock data.

# ---------------------------------------------------------------- GitHub
# Fine-grained or classic PAT. Read-only access to repos, issues, actions.
GITHUB_TOKEN=

# ---------------------------------------------------------------- Pi-hole
# Base URL of the Pi-hole (v6 API) and its password.
PIHOLE_URL=http://pi.hole
PIHOLE_PASSWORD=

# ---------------------------------------------------------------- Docker
# Docker is detected automatically at /var/run/docker.sock.
# Set OPSORA_DOCKER=mock to opt out, or override the socket path.
# OPSORA_DOCKER=
# DOCKER_SOCKET=/var/run/docker.sock

# ---------------------------------------------------------------- Agent
# Shared secret required from /api/agent when set.
# OPSORA_AGENT_TOKEN=
# Where ingested metrics are persisted between restarts.
# OPSORA_DATA_DIR=.data
